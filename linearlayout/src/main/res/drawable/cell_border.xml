<?xml version="1.0" encoding="utf-8"?>
<!--
  网格单元格边框：黑底 + 1dp 浅灰描边。
  对照文档截图，每个单元格都是一个带浅灰边框的方块（实测边框色约 #7D7D7D）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/grid_background" />
    <stroke
        android:width="1dp"
        android:color="@color/grid_line" />
</shape>
