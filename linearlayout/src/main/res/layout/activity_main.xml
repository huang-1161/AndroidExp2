            android:text="@string/cell_3_4"
            android:textColor="@color/cell_text_dim"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- ============ 第 4 行 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="158"
            android:background="@drawable/cell_border"
            android:gravity="center"
            android:text="@string/cell_4_1"
            android:textColor="@color/cell_text_dim"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="250"
            android:background="@drawable/cell_border"
            android:gravity="center"
            android:text="@string/cell_4_2"
            android:textColor="@color/cell_text_dim"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="180"
            android:background="@drawable/cell_border"
            android:gravity="center"
            android:text="@string/cell_4_3"
            android:textColor="@color/cell_text_dim"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="162"
            android:background="@drawable/cell_border"
            android:gravity="center"
            android:text="@string/cell_4_4"
            android:textColor="@color/cell_text_dim"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
